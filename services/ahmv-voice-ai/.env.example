# AHM Verdun Voice AI standalone runtime — names/defaults only, no secrets.
NODE_ENV=development
PORT=3000

# Public canonical endpoints used for Twilio signature validation.
PUBLIC_BASE_URL=https://voice-preprod.ahmverdun.ca
PUBLIC_WSS_URL=wss://voice-preprod.ahmverdun.ca

# Twilio — server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15816666246
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_SPEECH_MODEL=flux
TWILIO_TTS_VOICE=
TWILIO_INTELLIGENCE_SERVICE=
TWILIO_SPEECH_TIMEOUT_MS=900
TWILIO_DEEPGRAM_SMART_FORMAT=true
RELAY_RECONNECT_ATTEMPTS=1
ACTIVATION_ATTEMPTS=2
ACTIVATION_TIMEOUT_SECONDS=8

# OpenAI — server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=320

# Private AHMV website bridge.
AHM_DATA_MODE=api
AHM_VOICE_BRIDGE_URL=https://ahmverdun.ca/api/ahmv/voice/
AHM_VOICE_BRIDGE_TOKEN=
AHM_DATA_TIMEOUT_MS=4000
AHM_READINESS_PROBE_TTL_MS=30000
AHM_WEBSITE_URL=https://ahmverdun.ca

# Session persistence — server only.
SUPABASE_URL=
AHMV_SUPABASE_PROJECT_REF=bqflllsjxmhqsvemhhwv
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_PERSISTENT_STORE=false
PERSIST_ACTIVE_CONTEXT=false

# Access policy. Keep free_beta during controlled preproduction.
ACCESS_MODE=free_beta
PAID_ACCESS_POLICY=premium_or_trial
FREE_BETA_CALLS_PER_24H=0
MEMBERSHIP_URL=https://takatak.ca/login?next=%2Fdashboard%2Fhockey

# Operational service SMS only; not marketing.
SMS_ENABLED=true
SMS_FALLBACK_URL=https://ahmverdun.ca/horaires
SMS_MAX_CHARS=700

# Abuse/cost bounds.
VOICE_INSTANCE_MODE=single
MAX_CONCURRENT_CALLS=20
MAX_CONCURRENT_CALLS_PER_CALLER=1
MAX_TURNS_PER_CALL=30
MAX_CALL_DURATION_SECONDS=900
SESSION_TTL_MINUTES=120
SHUTDOWN_GRACE_MS=12000
