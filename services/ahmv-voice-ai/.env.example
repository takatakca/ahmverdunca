# AHM Verdun Voice AI — v0.7 preproduction
PUBLIC_BASE_URL=https://voice.ahmverdun.ca
PUBLIC_WSS_URL=wss://voice.ahmverdun.ca
PORT=3000
NODE_ENV=production
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+15816666246
TWILIO_VALIDATE_SIGNATURES=true
ACTIVATION_ATTEMPTS=2
ACTIVATION_TIMEOUT_SECONDS=8
TWILIO_SPEECH_MODEL=flux
TWILIO_SPEECH_TIMEOUT_MS=900
TWILIO_DEEPGRAM_SMART_FORMAT=true
TWILIO_TTS_VOICE=
TWILIO_INTELLIGENCE_SERVICE=
RELAY_RECONNECT_ATTEMPTS=1
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=320
# Operator-overridable cost model. Defaults reflect the reviewed 2026-10-03 rates.
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.2
OPENAI_OUTPUT_USD_PER_MILLION=12
TWILIO_INBOUND_USD_PER_MINUTE=0.0085
TWILIO_CONVERSATION_RELAY_USD_PER_MINUTE=0.07
# 0 = observe/report only. Set a positive per-call threshold after real usage baselining.
COST_GUARD_SESSION_USD=0
AHM_DATA_MODE=api
AHM_VOICE_BRIDGE_URL=https://ahmverdun.ca/api/ahmv/voice/
AHM_VOICE_BRIDGE_TOKEN=replace_with_shared_random_secret
AHM_DATA_TIMEOUT_MS=4000
AHM_READINESS_PROBE_TTL_MS=30000
AHM_WEBSITE_URL=https://ahmverdun.ca
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_PERSISTENT_STORE=true
PERSIST_ACTIVE_CONTEXT=false
ACCESS_MODE=free_beta
FREE_BETA_CALLS_PER_24H=0
PAID_ACCESS_POLICY=premium_or_trial
MEMBERSHIP_URL=https://takatak.ca/login?next=%2Fdashboard%2Fhockey
# Feature flags: ship stable capabilities ON; unfinished commercial upgrades OFF.
FEATURE_SCHEDULE_LOOKUP_ENABLED=true
FEATURE_ARENA_LOOKUP_ENABLED=true
FEATURE_SMS_RECAP_ENABLED=true
FEATURE_HUMAN_HANDOFF_ENABLED=false
FEATURE_TEAM_PERSONALIZATION_ENABLED=false
FEATURE_PREMIUM_ANALYTICS_ENABLED=false
SMS_ENABLED=true
SMS_FALLBACK_URL=https://ahmverdun.ca/horaires
SMS_MAX_CHARS=700
VOICE_INSTANCE_MODE=single
MAX_CONCURRENT_CALLS=20
MAX_CONCURRENT_CALLS_PER_CALLER=1
MAX_TURNS_PER_CALL=30
MAX_CALL_DURATION_SECONDS=900
SESSION_TTL_MINUTES=120
SHUTDOWN_GRACE_MS=12000
