# Public/client configuration
# Publishable/anon credentials only. Never use sb_secret_ or service_role here.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
# This value is shipped to browsers: sb_publishable_... or legacy anon JWT only.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only secrets — never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Keep false for proposal/pre-production. Enable only for approved production launch.
VITE_PUBLIC_INDEXING=false
