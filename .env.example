# Public/client configuration
# Publishable/anon credentials only. Never use sb_secret_ or service_role here.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Non-secret safety pin: AHMV Phone/Voice must never run against a TAKATAK/FESTI ICE/Food Hub database.
AHMV_SUPABASE_PROJECT_REF=bqflllsjxmhqsvemhhwv
VITE_SUPABASE_PROJECT_ID=
# This value is shipped to browsers: sb_publishable_... or legacy anon JWT only.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only secrets — never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Keep false for proposal/pre-production. Enable only for approved production launch.
VITE_PUBLIC_INDEXING=false

# Optional public marketing identifiers: leave blank until supplied by the owner.
# These adapters load only after the matching explicit visitor consent.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_MICROSOFT_UET_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_PINTEREST_TAG_ID=
# Search-engine ownership tokens are public metadata, not API credentials.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Local visitor/member visual preview only. Must stay false on the public production site.
# Real ad suppression must come from verified TAKATAK entitlements, never localStorage.
VITE_DEMO_MEMBER_PREVIEW_ENABLED=false

# Public first-visit welcome panel (mobile and desktop), with a permanent reopen control.
# This navigation help does not activate Phone/SMS, accounts or provider services.
# Explicit false at build time opts out; an unset value keeps the welcome panel enabled.
VITE_COMMUNICATIONS_PREVIEW_ENABLED=true

# Assistant remains available from its persistent button; the timed nudge is optional.
# Keep false for a calmer public experience unless AHMV explicitly wants proactive prompting.
VITE_ASSISTANT_NUDGE_ENABLED=false

# AHMV incoming phone/SMS (server-only; disabled until production QA)
AHMV_PHONE_ENABLED=false
# Set true only after a real inbound call confirms carrier/Twilio routing.
# This server-side release switch controls click-to-call through /api/ahmv/phone-status.
AHMV_PHONE_PUBLIC=false
# Non-secret carrier ownership/routing proof. Keep blank while NumberBarn controls the public number.
# Set exactly "twilio" only after the number is confirmed in the intended Twilio account and live routing is accepted.
AHMV_PHONE_CARRIER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AHMV_WEBHOOK_ORIGIN=https://ahmverdun.ca
AHMV_PUBLIC_PHONE=+15816666246
# Optional approved mappings: normalized SMS code -> exact official group name.
AHMV_TEAM_ALIASES_JSON={}
# Optional urgent bulletin. ISO timestamp with timezone is required.
AHMV_URGENT_FR=
AHMV_URGENT_EN=
AHMV_URGENT_ES=
AHMV_URGENT_UNTIL=

# AHMV Parent Premium — presentation stays hidden until explicitly enabled.
# TAKATAK Auth is the identity entry point; TAKATAK Dashboard owns subscriptions,
# Stripe billing, communication preferences and premium entitlements.
VITE_PARENT_PREMIUM_VISIBLE=false
VITE_PARENT_PREMIUM_LAUNCH_ENABLED=false
# Exact HTTPS TAKATAK Auth entry. Recommended launch handoff:
# https://takatak.ca/login?next=%2Fdashboard%2Fhockey
# No OAuth token, Stripe secret or entitlement state belongs in this browser variable.
VITE_TAKATAK_AUTH_START_URL=

# AHMV independent Family Experience. Disabled until TAKATAK launch/exchange/introspection
# endpoints, the AHMV server session secret and production entitlement flow are verified.
AHMV_EXPERIENCE_ENABLED=false
TAKATAK_AHMV_LAUNCH_URL=https://takatak.ca/api/experiences/ahmv/launch
TAKATAK_AHMV_EXCHANGE_URL=https://takatak.ca/api/experiences/ahmv/exchange
TAKATAK_AHMV_INTROSPECT_URL=https://takatak.ca/api/experiences/ahmv/introspect
AHMV_EXPERIENCE_SESSION_SECRET=

# Public newsletter/preferences handoff. This is only a browser-safe HTTPS entry point.
# TAKATAK owns consent, email storage, preference center and unsubscribe.
VITE_TAKATAK_NEWSLETTER_URL=

# AHMV Phone v2 / GROUPE TAKATAK boundary (server-only)
AHMV_PHONE_TRIAL_DAYS=30
# Future tenant-scoped TAKATAK entitlement endpoint. Leave blank until available.
TAKATAK_AHMV_ENTITLEMENT_URL=
TAKATAK_AHMV_SERVICE_TOKEN=
TAKATAK_AHMV_MEMBER_URL=https://takatak.ca/login?next=%2Fdashboard%2Fhockey

# Credential-free internal demo endpoint. Keep disabled in production unless explicitly needed.
AHMV_PHONE_DEMO_ENABLED=false
AHMV_PHONE_DEMO_TOKEN=

# Protected aggregated phone/SMS metrics for TAKATAK Dashboard.
AHMV_PHONE_OPS_ENABLED=false
TAKATAK_AHMV_EVENTS_URL=
# Future exact-event reminder planner. No cron delivery is enabled yet.
AHMV_GAME_REMINDER_LEAD_MINUTES=120

# Communication privacy retention. Keep cron disabled until AHMV Supabase is connected.
AHMV_PHONE_RETENTION_ENABLED=false
AHMV_PHONE_MESSAGE_BODY_RETENTION_DAYS=30
AHMV_PHONE_INTERACTION_RETENTION_DAYS=90
AHMV_PHONE_JOB_RETENTION_DAYS=180

# Lifecycle scheduler/dispatcher. Keep disabled until AHMV Supabase + Twilio are live.
AHMV_PHONE_LIFECYCLE_ENABLED=false

# Game reminders/change alerts. Keep disabled until exact team mapping + AHMV Supabase + Twilio are live.
AHMV_PHONE_REMINDERS_ENABLED=false
AHMV_REMINDER_TEAM_MAP_JSON={}

# Signed premium calendar links. Keep disabled until a dedicated server secret is configured.
AHMV_CALENDAR_LINKS_ENABLED=false
AHMV_CALENDAR_LINK_SECRET=

# Smart departure (server-only)
AHMV_SMART_DEPARTURE_ENABLED=false
AHMV_DEPARTURE_LINK_SECRET=
AHMV_DEPARTURE_ARRIVAL_BUFFER_MINUTES=30
# Optional GROUPE TAKATAK route/traffic service
TAKATAK_ROUTE_MATRIX_URL=
TAKATAK_ROUTE_SERVICE_TOKEN=

# TAKATAK -> AHMV membership projection. TAKATAK remains billing authority.
AHMV_TAKATAK_MEMBERSHIP_SYNC_ENABLED=false

# Backend-only TAKATAK managed-services control plane for AHMV.
# This never auto-mounts dashboard UI and must remain false until server integration/RBAC is explicitly connected.
TAKATAK_AHMV_CONTROL_PLANE_ENABLED=false

# TAKATAK-owned commercial SMS campaigns. Keep disabled until explicit consent, legal info URL and live carrier QA are complete.
AHMV_PHONE_CAMPAIGNS_ENABLED=false
TAKATAK_SMS_CEM_INFO_URL=
AHMV_TAKATAK_MARKETING_CONSENT_SYNC_ENABLED=false


# Exact-team public game/results connector (server-only).
# Reuses TAKATAK_AHMV_SERVICE_TOKEN above. Set this flag false only as an emergency kill switch.
# Official GameData/Scoresheets/WLLV systems remain authoritative; this proxy only normalizes approved public data.
TAKATAK_TEAM_GAMES_ENABLED=true
TAKATAK_TEAM_GAMES_ORIGIN=https://takatak.ca

# Exact-team social/news Team Feed bridge.
# Keep both gates false until TAKATAK provider OAuth, subscription state,
# exact-team mapping, attribution and unavailable-provider fallback are accepted.
VITE_TAKATAK_TEAM_FEED_ENABLED=false
TAKATAK_TEAM_FEED_ENABLED=false
TAKATAK_TEAM_FEED_ORIGIN=https://takatak.ca
TAKATAK_TEAM_FEED_TOKEN=

# AHMV Voice AI private bridge — server only
AHMV_VOICE_BRIDGE_TOKEN=
AHMV_VOICE_SESSION_RETENTION_DAYS=90

# Continuous authoritative AHMV schedule feed for Voice AI
TAKATAK_AHMV_SCHEDULE_URL=https://takatak.ca/api/integrations/ahmv/schedule
AHMV_LIVE_SCHEDULE_MAX_AGE_MINUTES=360
# Operator-only publisher for a reviewed official AHMV weekly document.
# Never guess the publication timestamp. Supply the real offset-aware source timestamp.
TAKATAK_AHMV_SCHEDULE_INGEST_URL=https://takatak.ca/api/integrations/ahmv/schedule/ingest
TAKATAK_AHMV_INGEST_TOKEN=
AHMV_WEEKLY_SOURCE_UPDATED_AT=


# TAKATAK ADS - proprietary local advertising network.
# Browser-safe publisher configuration only. Keep disabled until the central
# serve/event endpoints and the AHMV publisher seed are deployed and verified.
VITE_TAKATAK_ADS_ENABLED=false
VITE_TAKATAK_ADS_ORIGIN=https://takatak.ca
VITE_TAKATAK_ADS_PUBLISHER=ahmv

# TAKATAK community content moderation.
# Correction pens are public. While the server bridge below is off, a submitted
# correction is handed to VITE_CONTENT_CORRECTIONS_EMAIL (default: operations inbox).
# Explicit false at build time hides every pen.
VITE_TAKATAK_CONTENT_CONTRIBUTIONS_VISIBLE=true
VITE_CONTENT_CORRECTIONS_EMAIL=operation@ahmverdun.com
# Server-only. Keep disabled until TAKATAK is deployed and the shared token is configured on both services.
TAKATAK_CONTENT_CONTRIBUTIONS_ENABLED=false
TAKATAK_CONTENT_ORIGIN=https://takatak.ca
TAKATAK_AHMV_CONTENT_TOKEN=
